{
    "hosting": {
        "public": "dist",
        "ignore": [
            "firebase.json",
            "**/.*",
            "**/node_modules/**"
        ],
        "rewrites": [
            {
                "source": "/admin",
                "destination": "/app-shell.html"
            },
            {
                "source": "/admin/**",
                "destination": "/app-shell.html"
            },
            {
                "source": "/projects/**",
                "destination": "/app-shell.html"
            },
            {
                "source": "/services/**",
                "destination": "/app-shell.html"
            },
            {
                "source": "/operations/**",
                "destination": "/app-shell.html"
            }
        ],
        "headers": [
            {
                "source": "**/*.@(jpg|jpeg|gif|png|webp|svg|ico|css|js)",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "max-age=31536000, immutable"
                    }
                ]
            }
        ],
        "cleanUrls": true,
        "trailingSlash": false
    }
}
